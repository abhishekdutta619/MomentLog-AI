# Same Postgres instance apps/web points at — matches docker-compose.yml's
# POSTGRES_USER/PASSWORD/DB (all "momentlog").
DATABASE_URL=postgresql://momentlog:momentlog@localhost:5432/momentlog

# No API keys needed — embeddings and summaries both run locally via
# sentence-transformers / transformers (see app/config.py for the model
# names). First startup downloads model weights from Hugging Face once
# (~90MB for embeddings, a few GB for generation), then runs fully offline.
